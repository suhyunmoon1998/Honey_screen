NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://localhost/honey_case_adventure?schema=public
SESSION_COOKIE_NAME=honey_session
SESSION_TTL_HOURS=24
DEV_OTP_ENABLED=true
DEV_OTP_CODE=246810
DEV_STAFF_AUTH_ENABLED=true
DEV_STAFF_PASSWORD=jacklaw123
# Set to false to skip the phone OTP step entirely (client registers from the
# invite form immediately). Intended as a temporary launch mode until a real
# SMS OTP provider is wired in. Defaults to true (OTP required) when unset.
OTP_VERIFICATION_ENABLED=true
# Required whenever OTP_VERIFICATION_ENABLED=true and the dev code path is off
# (i.e. NODE_ENV is not "development" or DEV_OTP_ENABLED is false) — that's
# when the app sends a real SMS via Twilio instead of returning a fixed code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
INVITATION_SIGNING_SECRET=replace-with-a-local-secret
PRIVACY_POLICY_VERSION=2026-07-10
ORGANIZATION_DEFAULT_TIME_ZONE=America/Los_Angeles
WORKER_POLL_MS=500
WORKER_CLAIM_BATCH_SIZE=10
WORKER_DELIVERY_CONCURRENCY=4
WORKER_LEASE_MS=30000
WORKER_PROVIDER_TIMEOUT_MS=10000
WORKER_SHUTDOWN_GRACE_MS=10000
WORKER_RETRY_BASE_MS=1000
WORKER_RETRY_MAX_MS=60000
WORKER_NOTIFICATION_MAX_ATTEMPTS=5
SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=30000
SCHEDULER_BATCH_SIZE=25
SCHEDULER_LOOKAHEAD_MINUTES=15
SCHEDULER_CATCH_UP_MINUTES=60
DEFAULT_QUIET_HOURS_START=20:00
DEFAULT_QUIET_HOURS_END=08:00
ALLOWED_REMINDER_TIME_CHOICES=09:00,12:00,17:00,18:00
REMINDER_TEMPLATE_VERSION=V1
NOTIFICATION_CONSENT_VERSION=2026-07-12
SMS_REMINDERS_ENABLED=false
ALLOW_DEMO_CONTENT=true
PUSH_DELIVERY_ENABLED=false
PUSH_ENCRYPTION_KEY_B64=CwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCws=
PUSH_ENCRYPTION_KEY_VERSION=1
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
