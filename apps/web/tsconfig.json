{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "noEmit": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@honey/config": ["../../packages/config/src/index.ts"],
      "@honey/db": ["../../packages/db/src/index.ts"],
      "@honey/domain": ["../../packages/domain/src/index.ts"],
      "@honey/i18n": ["../../packages/i18n/src/index.ts"],
      "@honey/observability": ["../../packages/observability/src/index.ts"],
      "@honey/ui": ["../../packages/ui/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
